    },
    {
      "key": "motion",
      "group": "motion",
      "label": "Text motion",
      "type": "select",
      "default": "rise",
      "options": [
        [
          "rise",
          "Rise in"
        ],
        [
          "type",
          "Type on"
        ],
        [
          "wave",
          "Wave"
        ],
        [
          "scramble",
          "Scramble"
        ],
        [
          "stretch",
          "Stretch"
        ],
        [
          "bounce",
          "Bounce"
        ],
        [
          "slide",
          "Slide in"
        ],
        [
          "blur",
