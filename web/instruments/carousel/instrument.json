    },
    {
      "key": "perSlide",
      "group": "platform",
      "label": "Seconds a slide",
      "type": "number",
      "default": 4,
      "min": 1,
      "max": 20,
      "step": 0.5,
      "animate": false
    },
    {
      "key": "duration",
      "group": "platform",
      "label": "Loop length",
      "type": "number",
      "default": 4,
      "min": 0.5,
      "max": 600,
      "step": 0.5,
      "hidden": true,
