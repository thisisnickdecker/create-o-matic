{
  "id": "carousel",
  "name": "Carousel creator",
  "version": "0.2.0",
  "status": "experimental",
  "category": [
    "social",
    "typography",
    "layout",
    "motion"
  ],
  "description": "Carousels from what you're trying to say. Write it, one paragraph a slide; pick a layout system (Editorial, Poster, Tide, Zine, Notebook, Swiss) and bring your own fonts, colours and images. Every slide comes out at the platform's size: PNGs, a LinkedIn PDF, a moving slide, or the whole carousel as one video.",
  "author": "Nick Decker",
  "license": "MIT",
  "runtime": {
    "language": "javascript",
    "environment": "browser",
    "renderer": "canvas-2d",
    "build": "none"
  },
  "entry": {
    "engine": "carousel.js",
    "app": "app.js"
  },
  "page": "/carousel/",
  "interfaces": {
    "gui": true,
    "api": "window.instrument",
    "cli": false,
    "embed": false
  },
  "outputs": {
    "png": "verified",
    "png-set": "verified",
    "pdf": "verified",
    "mp4": "verified",
    "webm": "untested",
    "gif": "untested",
    "patch-json": "verified"
  },
  "reproducibility": "Same patch, fonts and images give the same slides; browsers rasterise glyphs slightly differently.",
  "references": [
    {
      "title": "A study of saved Instagram carousels",
      "note": "Six layout languages drawn out as principles (pacing, type pairing, frames, continuity), not copied: editorial serif frameworks, wood-type posters, full-bleed tide pieces, zines, notebooks and Swiss grids."
    }
  ],
  "groups": [
    {
      "id": "slides",
      "label": "Slides",
      "hint": "each slide's words, image and motion"
    },
    {
      "id": "words",
      "label": "Frame",
      "hint": "series line and signature"
    },
    {
      "id": "system",
      "label": "System",
      "hint": "the layout language"
    },
    {
      "id": "type",
      "label": "Type",
      "hint": "your fonts"
    },
    {
      "id": "colour",
      "label": "Colour",
      "hint": "paper, ink, accent, texture"
    },
    {
      "id": "platform",
      "label": "Platform",
      "hint": "sizes and slides"
    },
    {
      "id": "motion",
      "label": "Motion",
      "hint": "how slides move"
    }
  ],
  "parameters": [
    {
      "key": "text",
      "group": "words",
      "label": "What you're saying",
      "type": "text",
      "default": "The soul is a pattern *only you* can live\n\nPersonality is what happened to you.\n\n- Upbringing\n- Culture\n- Biology\n- Circumstance\n- Experience\n\nAll of it real. *None of it the whole story.*\n\n> The soul is the pattern underneath: what you are called to realise, through the life you actually have.\n\nSame world. A different pattern in *everyone.*\n\n-> Save this for the days you forget",
      "animate": false,
      "help": "An older patch's words, one paragraph a slide: read once into Slides.",
      "hidden": true
    },
    {
      "key": "slides",
      "label": "Slides",
      "type": "list",
      "default": [
        {
          "id": "slides-0",
          "text": "The soul is a pattern *only you* can live",
          "layout": "auto",
          "image": "",
          "fit": "full",
          "zoom": 1,
          "x": 0,
          "y": 0,
          "tone": "colour",
          "scrim": 0.6,
          "motion": "rise",
          "system": "inherit",
          "colours": "same"
        },
        {
          "id": "slides-1",
          "text": "Personality is what happened to you.",
          "layout": "auto",
          "image": "",
          "fit": "full",
          "zoom": 1,
          "x": 0,
          "y": 0,
          "tone": "colour",
          "scrim": 0.6,
          "motion": "scramble",
          "system": "inherit",
          "colours": "same"
        },
        {
          "id": "slides-2",
          "text": "- Upbringing\n- Culture\n- Biology\n- Circumstance\n- Experience",
          "layout": "auto",
          "image": "",
          "fit": "full",
          "zoom": 1,
          "x": 0,
          "y": 0,
          "tone": "colour",
          "scrim": 0.6,
          "motion": "slide",
          "system": "inherit",
          "colours": "same"
        },
        {
          "id": "slides-3",
          "text": "All of it real. *None of it the whole story.*",
          "layout": "auto",
          "image": "",
          "fit": "full",
          "zoom": 1,
          "x": 0,
          "y": 0,
          "tone": "colour",
          "scrim": 0.6,
          "motion": "highlight",
          "system": "inherit",
          "colours": "swap"
        },
        {
          "id": "slides-4",
          "text": "> The soul is the pattern underneath: what you are called to realise, through the life you actually have.",
          "layout": "auto",
          "image": "",
          "fit": "full",
          "zoom": 1,
          "x": 0,
          "y": 0,
          "tone": "colour",
          "scrim": 0.6,
          "motion": "type",
          "system": "inherit",
          "colours": "same"
        },
        {
          "id": "slides-5",
          "text": "Same world. A different pattern in *everyone.*",
          "layout": "auto",
          "image": "",
          "fit": "full",
          "zoom": 1,
          "x": 0,
          "y": 0,
          "tone": "colour",
          "scrim": 0.6,
          "motion": "wave",
          "system": "inherit",
          "colours": "accent"
        },
        {
          "id": "slides-6",
          "text": "-> Save this for the days you forget",
          "layout": "auto",
          "image": "",
          "fit": "full",
          "zoom": 1,
          "x": 0,
          "y": 0,
          "tone": "colour",
          "scrim": 0.6,
          "motion": "stretch",
          "system": "inherit",
          "colours": "same"
        }
      ],
      "group": "slides",
      "max": 35,
      "itemName": "a slide",
      "title": "{text}",
      "item": [
        {
          "key": "text",
          "label": "Words",
          "type": "text",
          "default": "A new slide",
          "help": "One slide's words. Lines starting - or 1. make a list; > makes a quote; -> makes a closing card. *Stars* mark emphasis."
        },
        {
          "key": "layout",
          "label": "Layout",
          "type": "select",
          "default": "auto",
          "options": [
            [
              "auto",
              "Read from the words"
            ],
            [
              "cover",
              "Cover"
            ],
            [
              "statement",
              "Statement"
            ],
            [
              "list",
              "List"
            ],
            [
              "quote",
              "Quote"
            ],
            [
              "big",
              "Big word"
            ],
            [
              "end",
              "Closing card"
            ]
          ]
        },
        {
          "key": "image",
          "label": "Image",
          "type": "media",
          "default": "",
          "help": "A photo or screenshot for this slide. Drag it on the stage to move it; scroll or pinch to resize."
        },
        {
          "key": "fit",
          "label": "Image fills",
          "type": "select",
          "default": "full",
          "options": [
            [
              "full",
              "The whole slide"
            ],
            [
              "top",
              "The top half"
            ],
            [
              "bottom",
              "The bottom half"
            ],
            [
              "left",
              "The left half"
            ],
            [
              "right",
              "The right half"
            ],
            [
              "free",
              "Wherever you put it"
            ],
            [
              "auto",
              "Where the system puts it"
            ]
          ],
          "when": {
            "image": {
              "not": ""
            }
          }
        },
        {
          "key": "zoom",
          "label": "Image size",
          "type": "number",
          "default": 1,
          "min": 0.1,
          "max": 4,
          "step": 0.01,
          "when": {
            "image": {
              "not": ""
            }
          }
        },
        {
          "key": "x",
          "label": "Image across",
          "type": "number",
          "default": 0,
          "min": -1,
          "max": 1,
          "step": 0.01,
          "when": {
            "image": {
              "not": ""
            }
          }
        },
        {
          "key": "y",
          "label": "Image down",
          "type": "number",
          "default": 0,
          "min": -1,
          "max": 1,
          "step": 0.01,
          "when": {
            "image": {
              "not": ""
            }
          }
        },
        {
          "key": "tone",
          "label": "Image tone",
          "type": "select",
          "default": "colour",
          "options": [
            [
              "colour",
              "Colour"
            ],
            [
              "mono",
              "Black and white"
            ],
            [
              "duotone",
              "In the slide's ink and paper"
            ]
          ],
          "when": {
            "image": {
              "not": ""
            }
          }
        },
        {
          "key": "scrim",
          "label": "Shade",
          "type": "number",
          "default": 0.6,
          "min": 0,
          "max": 1,
          "step": 0.01,
          "when": {
            "fit": "full"
          },
          "help": "Darkens or lightens a full-slide image so the words read."
        },
        {
          "key": "motion",
          "label": "Text motion",
          "type": "select",
          "default": "inherit",
          "options": [
            [
              "inherit",
              "As the carousel"
            ],
            [
              "rise",
              "Rise in"
            ],
            [
              "type",
              "Type on"
            ],
            [
              "wave",
              "Wave"
            ],
            [
              "scramble",
              "Scramble"
            ],
            [
              "stretch",
              "Stretch"
            ],
            [
              "bounce",
              "Bounce"
            ],
            [
              "slide",
              "Slide in"
            ],
            [
              "blur",
              "Blur in"
            ],
            [
              "highlight",
              "Highlight sweep"
            ],
            [
              "still",
              "Still"
            ]
          ]
        },
        {
          "key": "system",
          "label": "Look",
          "type": "select",
          "default": "inherit",
          "options": [
            [
              "inherit",
              "As the carousel"
            ],
            [
              "editorial",
              "Editorial"
            ],
            [
              "poster",
              "Poster"
            ],
            [
              "tide",
              "Tide"
            ],
            [
              "zine",
              "Zine"
            ],
            [
              "notebook",
              "Notebook"
            ],
            [
              "swiss",
              "Swiss"
            ]
          ]
        },
        {
          "key": "colours",
          "label": "Colours",
          "type": "select",
          "default": "same",
          "options": [
            [
              "same",
              "As the carousel"
            ],
            [
              "swap",
              "Swapped: ink becomes paper"
            ],
            [
              "accent",
              "On the accent"
            ]
          ]
        }
      ],
      "animate": false,
      "help": "Each slide's words, image, motion and look. Anything left 'As the carousel' follows the carousel's settings."
    },
    {
      "key": "kicker",
      "group": "words",
      "label": "Series",
      "type": "string",
      "default": "Field notes",
      "help": "A small line at the top of every slide: the series or the subject."
    },
    {
      "key": "footer",
      "group": "words",
      "label": "Signature",
      "type": "string",
      "default": "nickdecker.net",
      "help": "A small line at the foot of every slide: your name, handle or site."
    },
    {
      "key": "numbers",
      "group": "words",
      "label": "Slide numbers",
      "type": "bool",
      "default": true
    },
    {
      "key": "system",
      "group": "system",
      "label": "System",
      "type": "select",
      "default": "editorial",
      "options": [
        [
          "editorial",
          "Editorial"
        ],
        [
          "poster",
          "Poster"
        ],
        [
          "tide",
          "Tide"
        ],
        [
          "zine",
          "Zine"
        ],
        [
          "notebook",
          "Notebook"
        ],
        [
          "swiss",
          "Swiss"
        ]
      ],
      "help": "Editorial: a serif with italic emphasis, thin diagrams, numbered points. Poster: stacked capitals, each line set to the full width, like wood type. Tide: full-bleed colour and a drifting shape, words broken across the slide. Zine: typewriter text in label boxes. Notebook: lowercase serif, small photographs, lots of air. Swiss: a strict grid, big numbers and blocks."
    },
    {
      "key": "panorama",
      "group": "system",
      "label": "Panorama",
      "type": "bool",
      "default": false,
      "help": "One background runs across every slide, so the carousel joins up as you swipe."
    },
    {
      "key": "density",
      "group": "system",
      "label": "Type size",
      "type": "number",
      "default": 1,
      "min": 0.6,
      "max": 1.6,
      "step": 0.01,
      "animate": false,
      "help": "Larger or smaller type throughout."
    },
    {
      "key": "display",
      "group": "type",
      "label": "Headline font",
      "type": "font",
      "default": "Instrument Serif"
    },
    {
      "key": "displaySource",
      "group": "type",
      "label": "Source",
      "type": "select",
      "default": "open",
      "hidden": true,
      "options": [
        [
          "open",
          "Font library"
        ],
        [
          "google",
          "Google Fonts"
        ],
        [
          "adobe",
          "Adobe Fonts"
        ],
        [
          "system",
          "Installed"
        ],
        [
          "file",
          "My fonts"
        ]
      ]
    },
    {
      "key": "displayWeight",
      "group": "type",
      "label": "Headline weight",
      "type": "int",
      "default": 400,
      "min": 100,
      "max": 1000,
      "step": 10,
      "animate": false
    },
    {
      "key": "body",
      "group": "type",
      "label": "Text font",
      "type": "font",
      "default": "Inter Tight"
    },
    {
      "key": "bodySource",
      "group": "type",
      "label": "Source",
      "type": "select",
      "default": "open",
      "hidden": true,
      "options": [
        [
          "open",
          "Font library"
        ],
        [
          "google",
          "Google Fonts"
        ],
        [
          "adobe",
          "Adobe Fonts"
        ],
        [
          "system",
          "Installed"
        ],
        [
          "file",
          "My fonts"
        ]
      ]
    },
    {
      "key": "bodyWeight",
      "group": "type",
      "label": "Text weight",
      "type": "int",
      "default": 400,
      "min": 100,
      "max": 1000,
      "step": 10,
      "animate": false
    },
    {
      "key": "adobeKit",
      "group": "type",
      "label": "Adobe project",
      "type": "string",
