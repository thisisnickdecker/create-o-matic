          "Substack cover · 1456×1048"
        ],
        [
          "custom",
          "Custom"
        ]
      ],
      "help": "Instagram: up to 20 slides, the first sets the shape for all. LinkedIn: upload the PDF from the Print shop. TikTok photo mode: up to 35. Facebook: 2 to 10. Threads: up to 10 or 20 (accounts differ)."
    },
    {
      "key": "width",
      "group": "platform",
      "label": "Width",
      "type": "int",
      "min": 16,
      "max": 8000,
      "step": 2,
      "default": 1920,
      "when": {
        "platform": "custom"
      },
      "animate": false
    },
    {
      "key": "height",
      "group": "platform",
      "label": "Height",
      "type": "int",
      "min": 16,
      "max": 8000,
      "step": 2,
      "default": 1350,
      "when": {
        "platform": "custom"
      },
      "animate": false
    },
    {
      "key": "slide",
      "group": "platform",
      "label": "Slide",
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 35,
      "step": 1,
      "animate": false,
      "help": "The slide on the stage, and the one PNG, MP4 and GIF export. Click a thumbnail to choose."
    },
    {
      "key": "view",
      "group": "platform",
      "label": "Stage shows",
      "type": "select",
      "default": "slide",
