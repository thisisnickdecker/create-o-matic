      }
    },
    {
      "key": "rows",
      "group": "grid",
      "label": "Rows",
      "type": "int",
      "min": 1,
      "max": 64,
      "step": 1,
      "default": 12,
      "when": {
        "layout": "grid"
      }
    },
    {
      "key": "columnOffset",
      "group": "grid",
      "label": "Column lag",
      "type": "number",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "default": 0.17,
