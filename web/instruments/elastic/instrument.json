{
  "id": "elastic",
  "name": "Elastic",
  "version": "0.4.0",
  "status": "experimental",
  "category": [
    "typography",
    "motion"
  ],
  "description": "A stretch-type engine. Words fill the cells of a grid; the cells breathe in waves that travel down rows and across columns, so letterforms stretch, squash and swap as they grow. Any number or colour can be keyframed across the loop. Every frame is a pure function of the patch and the time, so a loop always closes and an export always matches the preview.",
  "author": "Nick Decker",
  "license": "MIT",
  "runtime": {
    "language": "javascript",
    "environment": "browser",
    "renderer": "canvas-2d",
    "build": "none"
  },
  "entry": {
    "engine": "elastic.js",
    "app": "app.js",
    "embed": "embed.js"
  },
  "interfaces": {
    "gui": true,
    "api": "window.instrument",
    "cli": false,
    "embed": true
  },
  "outputs": {
    "interactive-web": "verified",
    "png": "verified",
    "mp4": "verified",
    "webm": "verified",
    "gif": "verified",
    "embed": "verified",
    "patch-json": "verified"
  },
  "reproducibility": "Same patch, seed and font files give the same frames in the same browser. Different browsers or font versions can shift glyph outlines slightly.",
  "references": [
    {
      "title": "DIA, type tool (screenshots via Are.na)",
      "url": "https://www.are.na/block/44102986",
      "note": "Inspiration for the mechanic: rows, columns, per-row and per-column phase offset, ease, content mapped to cell size. No DIA code or assets used; the tool URL no longer resolves."
    },
    {
      "title": "DIA",
      "url": "https://www.dia.studio/",
      "note": "Benchmark for motion, type, colour and time."
    }
  ],
  "groups": [
    {
      "id": "format",
      "label": "Paper",
      "hint": "size and time"
    },
    {
      "id": "type",
      "label": "Type case",
      "hint": "words, marks, fonts"
    },
    {
      "id": "grid",
      "label": "Loom",
      "hint": "the grid"
    },
    {
      "id": "shape",
      "label": "Stencil",
      "hint": "shape fill"
    },
    {
      "id": "motion",
      "label": "Clockwork",
      "hint": "motion and keyframes"
    },
    {
      "id": "colour",
      "label": "Ink well",
      "hint": "colour"
    },
    {
      "id": "backdrop",
      "label": "Stage",
      "hint": "gradient, image, video"
    }
  ],
  "parameters": [
