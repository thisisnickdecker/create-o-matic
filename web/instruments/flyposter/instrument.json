{
  "id": "flyposter",
  "name": "Flyposter",
  "version": "0.1.0",
  "status": "experimental",
  "category": [
    "social",
    "motion",
    "typography",
    "layout"
  ],
  "description": "Social posts for small businesses that aren't dull. Put in your logo and colours, say what you're promoting, pick a mood and hit Vary until it's fun and a bit weird: type, colour, layouts, emoji, stickers, cutouts and texture, moving. Rewrite your line through a copy lens. Export at story, feed, square or landscape size.",
  "author": "Nick Decker",
  "license": "MIT",
  "runtime": {
    "language": "javascript",
    "environment": "browser",
    "renderer": "canvas-2d",
    "build": "none"
  },
  "entry": {
    "engine": "flyposter.js",
    "app": "app.js"
  },
  "page": "/flyposter/",
  "interfaces": {
    "gui": true,
    "api": "window.instrument",
    "cli": false,
    "embed": false
  },
  "outputs": {
    "png": "verified",
    "mp4": "verified",
    "webm": "untested",
    "gif": "untested",
    "mov": "untested",
    "patch-json": "verified"
  },
  "reproducibility": "Same patch, fonts and pictures give the same frames; the emoji are vendored files, so they don't depend on the system's emoji font. Browsers rasterise glyphs slightly differently.",
  "references": [
    {
      "title": "Fly-posting, gig posters, zines, club flyers and hand-painted shop signs",
      "note": "Moods drawn from those traditions as ranges of layout, type, colour and motion; no posters or artwork copied."
    },
    {
      "title": "Noto Emoji (Google)",
      "note": "A set of 131 emoji, vendored unmodified as SVG under the Apache licence."
    }
  ],
  "groups": [
    {
      "id": "brand",
      "label": "Brand pocket",
      "hint": "logo and colours, remembered"
    },
    {
      "id": "words",
      "label": "Message",
      "hint": "what you're saying"
    },
    {
      "id": "feel",
      "label": "Mood board",
      "hint": "the feel, and Vary"
    },
    {
      "id": "layout",
      "label": "Paste-up",
      "hint": "layout"
    },
    {
      "id": "type",
      "label": "Type case",
      "hint": "fonts"
    },
    {
      "id": "colour",
      "label": "Ink well",
      "hint": "colour"
    },
    {
      "id": "stuff",
      "label": "Junk drawer",
      "hint": "pictures, emoji, stickers"
    },
    {
      "id": "motion",
      "label": "Clockwork",
      "hint": "motion"
    },
    {
      "id": "format",
      "label": "Paper",
      "hint": "size and time"
    },
    {
      "id": "texture",
      "label": "Darkroom",
      "hint": "texture"
    }
  ],
  "parameters": [
    {
      "key": "brandName",
      "group": "brand",
      "label": "Name",
      "type": "string",
      "default": "Bar Nove",
      "help": "Your business's name. It signs the post when there's no logo."
    },
    {
      "key": "logo",
      "group": "brand",
      "label": "Logo",
      "type": "mark",
      "default": "",
      "help": "Drop an SVG, PNG or JPEG anywhere on the page. It's kept in this browser with your inks, for next time."
    },
    {
      "key": "logoColour",
      "group": "brand",
      "label": "Logo colour",
      "type": "select",
      "default": "original",
      "options": [
        [
          "original",
          "As drawn"
        ],
        [
          "ink",
          "In the type colour"
        ],
        [
          "auto",
          "Black or paper, whichever reads"
        ]
      ]
    },
    {
      "key": "inks",
      "group": "brand",
      "label": "Brand colours",
      "type": "palette",
      "default": [
        "#F2542D",
        "#2340D8",
        "#F6D743"
      ],
      "help": "Your colours. The mood decides which is the ground, which the type and which the accent."
    },
    {
      "key": "paper",
      "group": "brand",
      "label": "Paper",
      "type": "color",
      "default": "#F5F0E6",
      "help": "The light neutral: what a light post is printed on."
    },
    {
      "key": "black",
      "group": "brand",
      "label": "Black",
      "type": "color",
      "default": "#151412",
      "help": "The dark neutral: type on paper, the ground at night."
    },
    {
      "key": "headline",
      "group": "words",
      "label": "Headline",
      "type": "text",
      "default": "Happy hour",
      "animate": false,
      "help": "What you're promoting, in your words. A line break sets where it breaks."
    },
    {
      "key": "details",
      "group": "words",
      "label": "Details",
      "type": "string",
      "default": "5 to 7 · Thursdays",
      "help": "When, how much, what's on. Separate bits with · or commas."
    },
    {
      "key": "where",
      "group": "words",
      "label": "Where",
      "type": "string",
      "default": "Bar Nove, 12 Mill Lane"
    },
    {
      "key": "cta",
      "group": "words",
      "label": "Call to action",
      "type": "string",
      "default": "Bring a friend"
    },
    {
      "key": "lens",
      "group": "words",
      "label": "Copy lens",
      "type": "select",
      "default": "any",
      "options": [
        [
          "any",
          "Any voice"
        ],
        [
          "copywriter",
          "The copywriter"
        ],
        [
          "punk",
          "The punk"
        ],
        [
          "swiss",
          "The Swiss designer"
        ],
        [
          "deadpan",
          "The deadpan"
        ],
        [
          "shopkeeper",
          "The shopkeeper"
        ],
        [
          "mc",
          "The MC"
        ]
      ],
      "help": "Whose voice Rewrite uses. Archetypes, not real people."
    },
    {
      "key": "take",
      "group": "words",
      "label": "Rewrite",
      "type": "int",
      "min": 0,
      "max": 99,
      "step": 1,
      "default": 0,
      "animate": false,
      "help": "0 is your headline as written. Each step is another rewrite through the lens."
    },
    {
      "key": "mood",
      "group": "feel",
      "label": "Mood",
      "type": "select",
      "default": "loud",
      "options": [
        [
          "loud",
          "Loud"
        ],
        [
          "deadpan",
          "Deadpan"
        ],
        [
          "swiss",
          "Swiss"
        ],
        [
          "zine",
          "Zine"
        ],
        [
          "club",
          "Club flyer"
        ],
        [
          "gallery",
          "Gallery"
        ],
        [
          "shop",
          "Corner shop"
        ]
      ],
      "help": "Each mood deals layouts, type, colour, motion, stuff and texture from its own ranges. Changing it deals a new post; Vary deals another."
    },
    {
      "key": "lockLayout",
      "group": "feel",
      "label": "Keep layout",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "lockType",
      "group": "feel",
      "label": "Keep type",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "lockColour",
      "group": "feel",
      "label": "Keep colour",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "lockMotion",
      "group": "feel",
      "label": "Keep motion",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "lockStuff",
      "group": "feel",
      "label": "Keep stuff",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "lockTexture",
      "group": "feel",
      "label": "Keep texture",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "layout",
      "group": "layout",
      "label": "Layout",
      "type": "select",
      "default": "stack",
      "options": [
        [
          "stack",
          "Stacked"
        ],
        [
          "number",
          "Giant number"
        ],
        [
          "ticker",
          "Ticker"
        ],
        [
          "grid",
          "Grid"
        ],
        [
          "scatter",
          "Sticker scatter"
        ],
        [
          "poster",
          "Poster"
        ],
        [
          "badge",
          "Badge"
        ]
      ],
      "help": "Stacked fills the width a line at a time. Giant number finds the number in your words. Ticker runs it in bands. Grid sets the facts Swiss-style. Sticker scatter makes each word a sticker. Poster is a gig poster. Badge sets it round a circle."
    },
    {
      "key": "layoutSeed",
      "group": "layout",
      "label": "Variant",
      "type": "int",
      "min": 0,
      "max": 9999,
      "step": 1,
      "default": 17,
      "animate": false,
      "help": "Small decisions inside the layout: which side, which corner, how the stickers fall."
    },
    {
      "key": "align",
      "group": "layout",
      "label": "Align",
      "type": "select",
      "default": "left",
