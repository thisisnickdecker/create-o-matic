      "help": "Which of your colours plays which part. Step through them."
    },
    {
      "key": "transparent",
      "group": "colour",
      "label": "No ground",
      "type": "bool",
      "default": false,
      "help": "Leave the ground out, for a see-through MOV or a sticker PNG."
    },
    {
      "key": "image",
      "group": "stuff",
